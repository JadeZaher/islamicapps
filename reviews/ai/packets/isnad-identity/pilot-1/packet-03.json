  "glossary": [
    {
      "term": "isnad (إسناد)",
      "definition": "The list of narrators through whom a report reached the compiler, each said to have received it from the next; sanad is usually used as a synonym."
    },
    {
      "term": "Mention",
      "definition": "One name exactly as written at one position in one chain."
    },
    {
      "term": "kunya (كنية)",
      "definition": "A name of the form “father of” (Abu) or “mother of” (Umm) followed by another name, such as Abu Hurayra or Umm Salama, used as a respectful way of naming someone."
    },
    {
      "term": "ism (اسم)",
      "definition": "A person’s own given name, such as Muhammad, ʿAli or ʿAʾisha."
    },
    {
      "term": "nasab (نسب)",
      "definition": "The chain of “son of” (ibn) or “daughter of” (bint) that names a person’s father and earlier ancestors."
    },
    {
      "term": "nisba (نسبة)",
      "definition": "A name ending in -i that ties a person to a place, tribe, trade or school, such as al-Kufi (of Kufa) or al-Zuhri (of the Zuhra clan)."
    },
    {
      "term": "laqab (لقب)",
      "definition": "A descriptive title or nickname, such as al-Sadiq (the truthful) or al-Aʿmash (the bleary-eyed)."
    },
    {
      "term": "Derived relation",
      "definition": "A name given only by relation to the previous narrator, such as “his father” (abihi) or “his grandfather” (jaddihi)."
    },
    {
      "term": "tabaqa (طبقة)",
      "definition": "A generation or layer of narrators who lived and transmitted at about the same time, used to check that a student could have heard from a teacher."
    },
    {
      "term": "rijal (رجال)",
      "definition": "The study of narrators’ lives and reliability (ʿilm al-rijal), and the books that record it, giving each narrator’s name, teachers, students, dates and critics’ verdicts."
    },
    {
      "term": "mushtarak (المشترك)",
      "definition": "A name borne by two or more narrators; telling them apart (tamyiz al-mushtarakat) is a recognised branch of narrator study."
