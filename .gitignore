# Large derived hadith CSVs — gz-first convention.
# The `.gz` versions ARE committed (cloneable, well under GitHub's 100 MB
# limit at ~13-32 MB each). The plain `.csv` versions are gitignored and
# decompressed on demand by:
#   - `_ensure_csv_decompressed` in datasets/hadith-data/regen_unified_csvs.py
#   - `ensureCsvDecompressed` in src/scripts/lib/regen/io.ts
# Anyone cloning the repo gets the data; the pipeline does the decompression
# transparently on first run. See datasets/hadith-data/README.md for the
# corresponding regen / source-of-truth notes.
datasets/hadith-data/all_hadiths_unified.csv
datasets/hadith-data/all_hadiths_shia.csv
datasets/hadith-data/all_hadiths_clean.csv
datasets/hadith-data/archive/unified-snapshots/unified_hadith_consolidated.csv

# Per-batch unified CSV backups (`.bak-<tag>-<ts>` snapshots created by the
# regen pipeline before destructive rewrites). The most recent one is kept
# on disk for safety; the rest live in
# datasets/hadith-data/archive/unified-snapshots/.
datasets/hadith-data/all_hadiths_unified.csv.bak-*
datasets/hadith-data/.regen-publication.lock
datasets/hadith-data/development/

# Logs (regen runs produce GB of these)
logs/
*.log

# Python bytecode + caches
__pycache__/
*.pyc
*.pyo

# LibreOffice / Office lock files
.~lock.*#

# Local OS files
Thumbs.db

# Playwright MCP scratch output
.playwright-mcp/

# Generated diagnostics outputs (rebuild with the scripts; READMEs are tracked)
datasets/hadith-data/diagnostics/*/*
!datasets/hadith-data/diagnostics/*/README.md
!datasets/hadith-data/diagnostics/*/*.py

# Downloaded external sources (see each README for URL, licence and checksum)
datasets/sources/external/*/*
!datasets/sources/external/*/README.md
