      "kitab_no": 14,
      "bab_no": 18,
      "text_ar": "= حدثني زيد بن علي عن أبيه عن جده عن علي \" ع م \" قال: أهدي لرسول الله \" ص \" دجاج فطبخ بعضهن وشوى بعضهن ثم أتى بهن فأكل منهن فأكلت معه وما رأيت رسول الله \" ص \" جمع بين ادامين حتى لحق بالله تبارك وتعالى.",
      "page_ref": "V01P420",
      "sanad": [
        "Zayd ibn Ali",
        "Ali ibn al-Husayn (Zayn al-Abidin)",
        "al-Husayn ibn Ali"
      ],
      "sanad_detail": [
        {
          "name_ar": "زيد بن علي",
          "name_en": "Zayd ibn Ali",
          "school": "Medina",
          "tabaqah": "TABI_TABI_IN"
        },
        {
          "name_ar": "أبيه",
          "name_en": "Ali ibn al-Husayn (Zayn al-Abidin)",
          "school": "Medina",
          "tabaqah": "TABI_UN"
        },
        {
          "name_ar": "جده",
          "name_en": "al-Husayn ibn Ali",
          "school": "Medina",
          "tabaqah": "SAHABA"
        }
      ],
      "matn_ar": "له \" ص \" دجاج فطبخ بعضهن وشوى بعضهن ثم أتى بهن فأكل منهن فأكلت معه وما رأيت رسول الله \" ص \" جمع بين ادامين حتى لحق بالله تبارك وتعالى.",
      "chain_type": "Alid (Zaydi)",
      "school": "Medina"
    },
    {
      "id": "zayd_0686",
      "hadith_no": 686,
      "source": "Musnad al-Imam Zayd ibn Ali",
      "source_ar": "مسند الإمام زيد بن علي",
      "tradition": "Zaydi",
