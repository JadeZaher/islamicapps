        }
      ],
      "matn_ar": "م قال: جالب الطعام مرزوق والمحتكر عاص ملعون وقال زيد بن علي (ع م) لااحتكار الا في الحنطة والشعير والتمر.",
      "chain_type": "Alid (Zaydi)",
      "school": "Medina"
    },
