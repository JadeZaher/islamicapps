    {
      "id": "zayd_0607",
      "hadith_no": 607,
      "source": "Musnad al-Imam Zayd ibn Ali",
      "source_ar": "مسند الإمام زيد بن علي",
      "tradition": "Zaydi",
      "compiler": "Abd al-Aziz ibn Ishaq al-Baghdadi",
      "compiler_ar": "عبد العزيز بن إسحاق البغدادي",
      "kitab": "كتاب الفرائض (1)",
      "bab": "باب الوصايا:",
      "kitab_no": 14,
      "bab_no": 13,
      "text_ar": "= حدثني زيد بن علي عن أبيه عن جده عن علي (ع م) قال: لا وصية لقاتل ولا لوارث ولا لحزبي. حدثنى زيد بن علي عن أبيه عن جده عن علي (ع م) قال: لا وصية ولا ميراث حتى يقضى الدين ولان اوصي بالخمس أحب الي من ان اوصي بالربع ولان اوصي بالربع أحب الي من ان اوصي بالثلث ومن اوصى بالثلث فلم يترك شيئا. سألت زيدا بن علي (ع م) عن رجل اوصى لرجل ثلث ماله ولآخر بربعه، فقال: خذ مالا له ثلث وربع وهو اثنا عشر فالثلث أربعة والربع ثلاثة فيكون الثلث بينهما على سبعة .",
      "page_ref": "V01P377",
      "sanad": [
        "Zayd ibn Ali",
        "Ali ibn al-Husayn (Zayn al-Abidin)",
        "al-Husayn ibn Ali"
      ],
      "sanad_detail": [
