      "compiler": "Abd al-Aziz ibn Ishaq al-Baghdadi",
      "compiler_ar": "عبد العزيز بن إسحاق البغدادي",
      "kitab": "كتاب الطلاق",
      "bab": "باب طلاق السنة:",
      "kitab_no": 11,
      "bab_no": 1,
      "text_ar": "= حدثني زيد بن علي عن أبيه عن جده عن علي (ع م) المطلقة واحدة وثنتين وثلاثا لا تخرج من بيتها ليلا ولا نهارا حتى يحل أجلها والمتوفي عنها زوجا تخرج بالنهار ولا تبيت في غير بيتها ليلا ولا تقرب كل واحدة منهما زينة ولا طيبا الا ان يكون طلقها تطليقة أو تطليقتين فلا بأس ان تطيب وتزين.",
      "page_ref": "V01P321",
      "sanad": [
        "Zayd ibn Ali",
        "Ali ibn al-Husayn (Zayn al-Abidin)",
        "al-Husayn ibn Ali"
      ],
      "sanad_detail": [
        {
          "name_ar": "زيد بن علي",
          "name_en": "Zayd ibn Ali",
          "school": "Medina",
          "tabaqah": "TABI_TABI_IN"
        },
        {
          "name_ar": "أبيه",
          "name_en": "Ali ibn al-Husayn (Zayn al-Abidin)",
          "school": "Medina",
          "tabaqah": "TABI_UN"
        },
        {
          "name_ar": "جده",
          "name_en": "al-Husayn ibn Ali",
          "school": "Medina",
          "tabaqah": "SAHABA"
        }
      ],
      "matn_ar": "ليلا ولا نهارا حتى يحل أجلها والمتوفي عنها زوجا تخرج بالنهار ولا تبيت في غير بيتها ليلا ولا تقرب كل واحدة منهما زينة ولا طيبا الا ان يكون طلقها تطليقة أو تطليقتين فلا بأس ان تطيب وتزين.",
      "chain_type": "Alid (Zaydi)",
      "school": "Medina"
    },
    {
      "id": "zayd_0478",
      "hadith_no": 478,
      "source": "Musnad al-Imam Zayd ibn Ali",
      "source_ar": "مسند الإمام زيد بن علي",
      "tradition": "Zaydi",
      "compiler": "Abd al-Aziz ibn Ishaq al-Baghdadi",
      "compiler_ar": "عبد العزيز بن إسحاق البغدادي",
      "kitab": "كتاب الطلاق",
      "bab": "باب طلاق السنة:",
      "kitab_no": 11,
      "bab_no": 1,
      "text_ar": "= حدثني زيد بن علي عن أبيه عن جده عن علي (ع م) ان رجلا أتاه فقال: يا امير المؤمنين كان لي زوجة فطال صحبتها ولم تلد فطلقتها ولم تكن تحيض فاعتدت بالشهور وكانت ترى انها من القواعد فتزوجت زوجا فمكثت عنده ثلاثين شهرا فحاضت فأرسل إليها والى زوجها فسألهما عن ذلك فأخبرته انها اعتدت بالشهور من غير حيض، فقال للآخر لا شئ بينك وبينها ولها المهر بدخولك بها \" وقال للاول هي امرأتك ولا تقربها حتى تنقضي عدتها من هذا الاخير، قالت فبم أعتد يا أمير المؤمنين، قال بالحيض، قال فهلكت المرأة قبل ان تنقضي عدتها فورثها الزوج الاول ولم يرثها الاخير.",
      "page_ref": "V01P322",
      "sanad": [
        "Zayd ibn Ali",
        "Ali ibn al-Husayn (Zayn al-Abidin)",
        "al-Husayn ibn Ali"
      ],
      "sanad_detail": [
        {
          "name_ar": "زيد بن علي",
          "name_en": "Zayd ibn Ali",
          "school": "Medina",
          "tabaqah": "TABI_TABI_IN"
        },
        {
          "name_ar": "أبيه",
          "name_en": "Ali ibn al-Husayn (Zayn al-Abidin)",
          "school": "Medina",
          "tabaqah": "TABI_UN"
        },
        {
          "name_ar": "جده",
          "name_en": "al-Husayn ibn Ali",
          "school": "Medina",
          "tabaqah": "SAHABA"
        }
      ],
      "matn_ar": "د فتزوجت زوجا فمكثت عنده ثلاثين شهرا فحاضت فأرسل إليها والى زوجها فسألهما عن ذلك فأخبرته انها اعتدت بالشهور من غير حيض، فقال للآخر لا شئ بينك وبينها ولها المهر بدخولك بها \" وقال للاول هي امرأتك ولا تقربها حتى تنقضي عدتها من هذا الاخير، قالت فبم أعتد يا أمير المؤمنين، قال بالحيض، قال فهلكت المرأة قبل ان تنقضي عدتها فورثها الزوج الاول ولم يرثها الاخير.",
      "chain_type": "Alid (Zaydi)",
      "school": "Medina"
    },
