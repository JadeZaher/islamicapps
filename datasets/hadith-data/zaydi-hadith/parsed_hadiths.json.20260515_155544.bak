      ],
      "matn_ar": "ل ثوبه وأدنى ما تصلى فيه المرأة قميص وخمار، وقال زيد بن علي (ع م) والامة تصلي بغير خمار.",
      "chain_type": "Alid (Zaydi)",
      "school": "Medina"
    },
