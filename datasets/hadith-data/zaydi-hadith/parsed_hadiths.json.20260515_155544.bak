    {
      "id": "zayd_0492",
      "hadith_no": 492,
      "source": "Musnad al-Imam Zayd ibn Ali",
      "source_ar": "مسند الإمام زيد بن علي",
      "tradition": "Zaydi",
      "compiler": "Abd al-Aziz ibn Ishaq al-Baghdadi",
      "compiler_ar": "عبد العزيز بن إسحاق البغدادي",
      "kitab": "كتاب الطلاق",
      "bab": "باب الطلاق البائن:",
      "kitab_no": 11,
      "bab_no": 2,
      "text_ar": "= حدثني زيد بن علي عن أبيه عن جده عن علي (ع م) إذا قبل الرجل من امرأته فدية فقد بانت منه بتطليقة. لان النبي صلى الله عليه وآله يقول: من قال ان شاء الله تعالى فقد استثنى. وقد تقدم في باب الايمان رواية أبي خالد عن أبي الحسين (ع م) انه ما حلف يمينا قط الا استثنى فيها فقال ان شاء الله تعالى كان ذلك في رضى أو غضب. وقال (ع م): الاستثناء من كل شئ جائز. يعني بائن لان من طلق التي لم يدخل بها مرة بانت منه اه ام. والفرق بين انت طالق وطالق وطالق وبين قوله طالق ثلاثا ان قوله انت طالق في التي لم يدخل بها تطليقة بائن فقوله وطالق وطالق إيقاع للطلاق على من لا يملك عقدة نكاحها لبينونتها منه بخلاف قوله انت طالق ثلاثا فانها لم تطلق الا بمجموع اللفظ والتقييد هنا معتبر فان كانت مدخولا بها طلقت ثلاثا وان لم تكن مدخولا بها فكذلك اه ام.",
      "page_ref": "V01P328",
      "sanad": [
        "Zayd ibn Ali",
        "Ali ibn al-Husayn (Zayn al-Abidin)",
        "al-Husayn ibn Ali"
      ],
