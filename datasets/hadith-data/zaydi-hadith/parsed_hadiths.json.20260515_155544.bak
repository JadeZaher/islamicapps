        },
        {
          "name_ar": "جده",
          "name_en": "al-Husayn ibn Ali",
          "school": "Medina",
          "tabaqah": "SAHABA"
        }
      ],
      "matn_ar": "ليه السلام وإذا اسلمت في طعام أو في غيره فسم أجلك وسم ما أسلمت فيه وفي أي موضع تقبضه ولا تفارقه حتى تقبضه الدراهم فان خالفت واحدة من هذه الابع فسد سلمك، وقال زيد بن علي (ع م) لا بأس بالسلم في الثياب والاكسية إذا سميت الطول والعرض والرقعة، وقال زيد بن علي (ع م) لا يجوز السلم في الحيوان ولا في الرؤوس ولا في جلود الحيوان ولا بأس بالسلم في الصوف والقطن والحرير وجميع ما يكال ويوزن مما يوجد عند الناس.",
      "chain_type": "Alid (Zaydi)",
      "school": "Medina"
    },
