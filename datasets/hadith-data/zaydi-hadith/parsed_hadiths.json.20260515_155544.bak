    },
    {
      "id": "zayd_0285",
      "hadith_no": 285,
      "source": "Musnad al-Imam Zayd ibn Ali",
      "source_ar": "مسند الإمام زيد بن علي",
      "tradition": "Zaydi",
      "compiler": "Abd al-Aziz ibn Ishaq al-Baghdadi",
      "compiler_ar": "عبد العزيز بن إسحاق البغدادي",
      "kitab": "كتاب الحج",
      "bab": "باب جزاء الصيد:",
      "kitab_no": 6,
      "bab_no": 13,
      "text_ar": "= حدثني زيد بن علي عن أبيه عن جده عن علي (ع م) قال: لما كان في ولاية عمر أقبل قوم من اهل الشام محرمين فأصابوا بيض نعام فأوطأوا وكسروا وأخذوا، قال فأتوا عمر في ولايته فهم بهم وانتهرهم ثم قال: اتبعوني حتى آتي عليا قال فأتوا عليا وهو في ارض له وبيده مسحاة يقلع بها الارض فضرب عمر بيده عضده وقال: ما أخطأ من سماك أبا تراب! قال فقص القوم على علي بن أبي طالب القصة، قال فقال علي (ع م): انطلقوا إلى نوق أبكار فاطرقوها فحلها فما نتج فانحروه لله عزوجل. فقال عمر: يا أبا الحسن ان من البيض ما يمذق ، قال فقال عليه السلام: ومن النوق ما يزلق. وسألت زيدا بن علي (ع م) عن جزاء الصيد فقال (ع م): فيه الجزاء، قال وان لم تجد ما تنحره قومه طعاما ثم تصدق به على المساكين. قال عليه السلام: فان لم يجد ما يطعم صام مكان كل نصف صاع يوما. وسألت زيدا بن علي (ع م) عن القارن، قال عليه كفارتان، قال سألت زيدا بن علي (ع م) عن الحلال يقتل الصيد في الحرم، قال عليه الجزاء، قلت فان كان محرما قتل صيدا في الحرم، قال عليه كفارتان.",
      "page_ref": "V01P233",
      "sanad": [
        "Zayd ibn Ali",
        "Ali ibn al-Husayn (Zayn al-Abidin)",
        "al-Husayn ibn Ali"
      ],
      "sanad_detail": [
        {
          "name_ar": "زيد بن علي",
