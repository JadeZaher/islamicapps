        },
        {
          "name_ar": "جده",
          "name_en": "al-Husayn ibn Ali",
          "school": "Medina",
          "tabaqah": "SAHABA"
        }
      ],
      "matn_ar": " إلى الحجر الاسود فذلك شوط فليطف كذلك سبع مرات فان استطاع ان يتمسح بالحجر الاسود في كلهن فعل وان لم يجد إلى ذلك سبيلا مسح ذلك في اولهن وفي آخرهن، فإذا قضى طوافه فليأت مقام إبراهيم صلى الله على نبينا وعليه وعلى آلهما وسلم فليصل ركعتين واربع سجدات ثم ليسلم ثم ليتمسح بالحجر الاسود بعد التسليم حين يريد الخروج إلى الصفا والمروة.",
      "chain_type": "Alid (Zaydi)",
      "school": "Medina"
    },
