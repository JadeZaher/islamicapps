        },
        {
          "name_ar": "أبيه",
          "name_en": "Ali ibn al-Husayn (Zayn al-Abidin)",
          "school": "Medina",
          "tabaqah": "TABI_UN"
        },
        {
          "name_ar": "جده",
          "name_en": "al-Husayn ibn Ali",
          "school": "Medina",
          "tabaqah": "SAHABA"
        }
      ],
      "matn_ar": "ير اذني، فقال له علي عليه السلام فرق بينهما، فقال السيد لعبده طلقها يا عدو الله، فقال علي عليه السلام للسيد قد أجزت النكاح فان شئت ايها العبد فطلق وان شئت فأمسك .",
      "chain_type": "Alid (Zaydi)",
      "school": "Medina"
    },
