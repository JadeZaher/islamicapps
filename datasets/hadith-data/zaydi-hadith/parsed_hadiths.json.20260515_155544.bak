      "school": "Medina"
    },
    {
      "id": "zayd_0456",
      "hadith_no": 456,
      "source": "Musnad al-Imam Zayd ibn Ali",
      "source_ar": "مسند الإمام زيد بن علي",
      "tradition": "Zaydi",
      "compiler": "Abd al-Aziz ibn Ishaq al-Baghdadi",
      "compiler_ar": "عبد العزيز بن إسحاق البغدادي",
      "kitab": "كتاب النكاح (1)",
      "bab": "باب نكاح اهل الكفر (1):",
      "kitab_no": 10,
      "bab_no": 7,
      "text_ar": "= حدثني زيد بن علي عن أبيه عن جده عن علي (ع م) في مجوسي له ابنة ابن وله ابن آخر فتزوج ابنة ابنه ثم اسلموا جميعا فخطبها ابن عمها فجاءوا إلى علي عليه السلام في ذلك، فقال ان كان الجد دخل بها لم تحل لابن عمها وان كان لم يدخل بها حلت له.",
      "page_ref": "V01P311",
      "sanad": [
        "Zayd ibn Ali",
        "Ali ibn al-Husayn (Zayn al-Abidin)",
        "al-Husayn ibn Ali"
      ],
      "sanad_detail": [
        {
          "name_ar": "زيد بن علي",
          "name_en": "Zayd ibn Ali",
          "school": "Medina",
          "tabaqah": "TABI_TABI_IN"
        },
        {
          "name_ar": "أبيه",
          "name_en": "Ali ibn al-Husayn (Zayn al-Abidin)",
          "school": "Medina",
          "tabaqah": "TABI_UN"
        },
        {
          "name_ar": "جده",
          "name_en": "al-Husayn ibn Ali",
          "school": "Medina",
          "tabaqah": "SAHABA"
        }
      ],
      "matn_ar": "خر فتزوج ابنة ابنه ثم اسلموا جميعا فخطبها ابن عمها فجاءوا إلى علي عليه السلام في ذلك، فقال ان كان الجد دخل بها لم تحل لابن عمها وان كان لم يدخل بها حلت له.",
      "chain_type": "Alid (Zaydi)",
      "school": "Medina"
    },
