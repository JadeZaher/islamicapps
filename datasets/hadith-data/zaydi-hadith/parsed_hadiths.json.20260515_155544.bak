    {
      "id": "zayd_0586",
      "hadith_no": 586,
      "source": "Musnad al-Imam Zayd ibn Ali",
      "source_ar": "مسند الإمام زيد بن علي",
      "tradition": "Zaydi",
      "compiler": "Abd al-Aziz ibn Ishaq al-Baghdadi",
      "compiler_ar": "عبد العزيز بن إسحاق البغدادي",
      "kitab": "كتاب الفرائض (1)",
      "bab": "باب الجد:",
      "kitab_no": 14,
      "bab_no": 3,
      "text_ar": "= حدثني زيد بن علي عن أبيه عن جده عن علي (ع م) انه كان يجعل الجد بمنزلة اخ إلى السدس وكان يعطي الاخت النصف وما بقي فللجد وكان يعطي الاختين وأكثر من ذلك الثلثين وما بقي فللجد وكان لا يزيد الجد مع الولد على السدس الا ان يفضل من المال شئ فيكون له .",
      "page_ref": "V01P366",
      "sanad": [
        "Zayd ibn Ali",
        "Ali ibn al-Husayn (Zayn al-Abidin)",
        "al-Husayn ibn Ali"
      ],
      "sanad_detail": [
        {
          "name_ar": "زيد بن علي",
          "name_en": "Zayd ibn Ali",
          "school": "Medina",
          "tabaqah": "TABI_TABI_IN"
        },
        {
          "name_ar": "أبيه",
          "name_en": "Ali ibn al-Husayn (Zayn al-Abidin)",
          "school": "Medina",
          "tabaqah": "TABI_UN"
        },
        {
          "name_ar": "جده",
          "name_en": "al-Husayn ibn Ali",
          "school": "Medina",
          "tabaqah": "SAHABA"
        }
      ],
      "matn_ar": "سدس وكان يعطي الاخت النصف وما بقي فللجد وكان يعطي الاختين وأكثر من ذلك الثلثين وما بقي فللجد وكان لا يزيد الجد مع الولد على السدس الا ان يفضل من المال شئ فيكون له .",
      "chain_type": "Alid (Zaydi)",
      "school": "Medina"
    },
    {
      "id": "zayd_0587",
      "hadith_no": 587,
      "source": "Musnad al-Imam Zayd ibn Ali",
      "source_ar": "مسند الإمام زيد بن علي",
      "tradition": "Zaydi",
      "compiler": "Abd al-Aziz ibn Ishaq al-Baghdadi",
      "compiler_ar": "عبد العزيز بن إسحاق البغدادي",
      "kitab": "كتاب الفرائض (1)",
      "bab": "باب الجد:",
      "kitab_no": 14,
      "bab_no": 3,
      "text_ar": "= حدثني زيد بن علي عن أبيه عن جده عن علي (ع م) انه كان يقول في اخت لاب وام واخت لاب وجد للاخت من الاب والام النصف وللاخت من الاب السدس تكملة الثلثين وما بقي فللجد وكان يقول في ام وامرأة واخوات واخوة وجد للمرأة الربع وللام السدس ويجعل ما بقي بين الاخوات والاخوة والجد للذكر مثل حظ الانثيين وهو بمنزلة اخ الا ان يكون سدس جميع المال خيرا له فيعطيه سدس جميع المال وكان لا يؤرث ابن اخ مع جد ولا اخا لام مع جد وكان يقول في ام وزوج واخت وجد للزوج النصف ثلاثة وللاخت ثلاثة وللام الثلث سهمان وللجد السدس فصارت تسعة وكذلك كان يعيل الفرائض.",
      "page_ref": "V01P367",
      "sanad": [
        "Zayd ibn Ali",
        "Ali ibn al-Husayn (Zayn al-Abidin)",
        "al-Husayn ibn Ali"
      ],
      "sanad_detail": [
        {
          "name_ar": "زيد بن علي",
          "name_en": "Zayd ibn Ali",
          "school": "Medina",
          "tabaqah": "TABI_TABI_IN"
        },
        {
          "name_ar": "أبيه",
          "name_en": "Ali ibn al-Husayn (Zayn al-Abidin)",
          "school": "Medina",
          "tabaqah": "TABI_UN"
        },
        {
          "name_ar": "جده",
          "name_en": "al-Husayn ibn Ali",
          "school": "Medina",
          "tabaqah": "SAHABA"
        }
      ],
      "matn_ar": "ام وامرأة واخوات واخوة وجد للمرأة الربع وللام السدس ويجعل ما بقي بين الاخوات والاخوة والجد للذكر مثل حظ الانثيين وهو بمنزلة اخ الا ان يكون سدس جميع المال خيرا له فيعطيه سدس جميع المال وكان لا يؤرث ابن اخ مع جد ولا اخا لام مع جد وكان يقول في ام وزوج واخت وجد للزوج النصف ثلاثة وللاخت ثلاثة وللام الثلث سهمان وللجد السدس فصارت تسعة وكذلك كان يعيل الفرائض.",
      "chain_type": "Alid (Zaydi)",
      "school": "Medina"
    },
    {
