      "matn_ar": "يب رجل من اصحاب رسول الله صلى الله عليه وآله فغسله وكفنه وصلى عليه ثم أقبل علينا بوجه الكريم، فقال هذا المطهر يلقى الله عز وجل بلا ذنب له يتبعه.",
      "chain_type": "Alid (Zaydi)",
      "school": "Medina"
    },
    {
      "id": "zayd_0262",
      "hadith_no": 262,
      "source": "Musnad al-Imam Zayd ibn Ali",
      "source_ar": "مسند الإمام زيد بن علي",
      "tradition": "Zaydi",
      "compiler": "Abd al-Aziz ibn Ishaq al-Baghdadi",
      "compiler_ar": "عبد العزيز بن إسحاق البغدادي",
      "kitab": "كتاب الحج",
      "bab": "باب ما يوجب الحج:",
      "kitab_no": 6,
      "bab_no": 2,
      "text_ar": "= حدثني زيد بن علي عن أبيه عن جده عن علي عليهم السلام في قول الله عزوجل: ولله على الناس حج البيت من استطاع إليه سبيلا. قال عليه السلام: السبيل الزاد والراحلة، وقال عليه السلام: ولما نزلت هذه الآية قام رجل إلى النبي صلى الله عليه وآله فقال: يارسول الله الحج واجب علينا في كل سنة أو مرة واحدة في الدهر؟ فقال النبي صلى الله عليه وآله: بل مرة واحدة ولو قلت في كل سنة لوجب. قال يارسول الله فالعمرة واجبة مثل الحج؟ قال لا، ولكن ان اعتمرت خيرا لك .",
      "page_ref": "V01P222",
      "sanad": [
        "Zayd ibn Ali",
        "Ali ibn al-Husayn (Zayn al-Abidin)",
        "al-Husayn ibn Ali"
      ],
      "sanad_detail": [
        {
          "name_ar": "زيد بن علي",
          "name_en": "Zayd ibn Ali",
          "school": "Medina",
          "tabaqah": "TABI_TABI_IN"
        },
        {
          "name_ar": "أبيه",
          "name_en": "Ali ibn al-Husayn (Zayn al-Abidin)",
          "school": "Medina",
          "tabaqah": "TABI_UN"
        },
        {
          "name_ar": "جده",
          "name_en": "al-Husayn ibn Ali",
          "school": "Medina",
          "tabaqah": "SAHABA"
        }
      ],
      "matn_ar": "د والراحلة، وقال عليه السلام: ولما نزلت هذه الآية قام رجل إلى النبي صلى الله عليه وآله فقال: يارسول الله الحج واجب علينا في كل سنة أو مرة واحدة في الدهر؟ فقال النبي صلى الله عليه وآله: بل مرة واحدة ولو قلت في كل سنة لوجب. قال يارسول الله فالعمرة واجبة مثل الحج؟ قال لا، ولكن ان اعتمرت خيرا لك .",
      "chain_type": "Alid (Zaydi)",
      "school": "Medina"
    },
    {
      "id": "zayd_0263",
      "hadith_no": 263,
      "source": "Musnad al-Imam Zayd ibn Ali",
