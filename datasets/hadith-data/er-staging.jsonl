# er-staging.jsonl — Entity Resolution HITL Staging Queue
# =========================================================
# Track: neo4j_isnad_graph_regen_20260516 — Phase 2 (FR-2.3, FR-2.4, G-5, NFR-3)
#
# PURPOSE
# -------
# This file is the Human-In-The-Loop (HITL) queue for ambiguous narrator
# entity resolution. It is populated automatically by resolveNarrators()
# (src/scripts/lib/regen/entity-resolution.ts) during a fullregen run.
# Human reviewers read this file, confirm or reject candidates, and mark
# approved rows. The ingest-er-approved.ts script then commits ONLY
# approved rows as :RESOLVES_TO edges in Neo4j.
#
# INVARIANT: No :RESOLVES_TO or :SAME_AS edge is ever written without
#   reviewed_by and reviewed_at (spec G-5, FR-2.4). This file itself is
#   never imported directly into Neo4j.
#
# HOW TO USE
# ----------
# 1. Run: npm run db:regen -- --mode=fullregen
#    → Ambiguous names are appended here as JSON lines.
#
# 2. For each JSON line, review the `candidates` array.
#    - Set `approved: true` on the row you want to commit.
#    - Set `approved_scholar_indx` to the correct candidate's scholar_indx.
#    - Set `reviewed_by` to your identifier (e.g. "jade.zaher@2026-05").
#    - Set `reviewed_at` to the ISO 8601 datetime (e.g. "2026-05-20T14:00:00Z").
#
# 3. Run: npm run db:ingest-er
#    → Only rows with `approved: true` are committed.
#    → Already-committed edges are idempotently skipped.
#
# QUARANTINE (NFR-3 / no-GIGO)
# -----------------------------
# Records from unmeasured strata (Imami 16% gap, Ibadi, Zaydi,
# transliterated cross-tradition) have `quarantined: true`. Even when
# approved, these edges carry quarantined=true and are excluded from
# downstream analytics by default. Use `--include-quarantined` in audit
# queries to include them.
#
# SCHEMA (each non-comment line is a JSON object)
# ------------------------------------------------
# {
#   "staged_at": <unix ms>,           // when this record was emitted
#   "surface_form": <string>,         // original Arabic text token
#   "normalized_form": <string>,      // after _norm() stripping
#   "source_row_id": <string>,        // dataset_row_id or "source|hadith_no"
#   "tradition": <string>,            // "Sunni"|"Imami"|"Ibadi"|"Zaydi"
#   "position": <number>,             // position in the sanad (0-indexed)
#   "candidates": [                   // ranked by score, best first (max 5)
#     {
#       "scholar_indx": <number>,
#       "name": <string>,
#       "grade": <string|undefined>,
#       "death_date_hijri": <number|null>,
#       "score": <float 0-1>,
#       "features": { ... }           // match features for transparency
#     }
#   ],
#   // ── Human-filled fields (DO NOT set programmatically) ──
#   "approved": <boolean>,            // set true to commit
#   "approved_scholar_indx": <number>,// which candidate to commit
#   "reviewed_by": <string>,          // reviewer identifier
#   "reviewed_at": <ISO 8601>,        // review timestamp
#   "quarantined": <boolean>          // true for unmeasured strata (NFR-3)
# }
#
