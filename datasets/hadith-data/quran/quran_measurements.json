      {
        "ref": "3:77",
        "reports": 42,
        "sura_name_ar": "آل عمران",
        "text": "إن الذين يشترون بعهد الله وأيمانهم ثمنا قليلا أولئك لا خلاق لهم في الآخرة ولا يكلمهم الله "
      },
      {
        "ref": "25:68",
        "reports": 35,
        "sura_name_ar": "الفرقان",
        "text": "والذين لا يدعون مع الله إلها آخر ولا يقتلون النفس التي حرم الله إلا بالحق ولا يزنون ومن يف"
      },
      {
        "ref": "2:158",
        "reports": 34,
        "sura_name_ar": "البقرة",
        "text": "إن الصفا والمروة من شعائر الله فمن حج البيت أو اعتمر فلا جناح عليه أن يطوف بهما ومن تطوع خ"
      },
      {
        "ref": "4:59",
        "reports": 34,
        "sura_name_ar": "النساء",
        "text": "يا أيها الذين آمنوا أطيعوا الله وأطيعوا الرسول وأولي الأمر منكم فإن تنازعتم في شيء فردوه إ"
      },
      {
        "ref": "6:158",
        "reports": 33,
        "sura_name_ar": "الأنعام",
        "text": "هل ينظرون إلا أن تأتيهم الملائكة أو يأتي ربك أو يأتي بعض آيات ربك يوم يأتي بعض آيات ربك لا"
      },
      {
        "ref": "2:187",
        "reports": 31,
        "sura_name_ar": "البقرة",
        "text": "أحل لكم ليلة الصيام الرفث إلى نسائكم هن لباس لكم وأنتم لباس لهن علم الله أنكم كنتم تختانون"
      },
      {
        "ref": "31:34",
        "reports": 31,
        "sura_name_ar": "لقمان",
        "text": "إن الله عنده علم الساعة وينزل الغيث ويعلم ما في الأرحام وما تدري نفس ماذا تكسب غدا وما تدر"
      },
      {
        "ref": "6:162",
        "reports": 30,
        "sura_name_ar": "الأنعام",
        "text": "قل إن صلاتي ونسكي ومحياي ومماتي لله رب العالمين"
      },
      {
        "ref": "1:7",
        "reports": 29,
        "sura_name_ar": "الفاتحة",
        "text": "صراط الذين أنعمت عليهم غير المغضوب عليهم ولا الضالين"
      },
      {
        "ref": "6:163",
        "reports": 29,
        "sura_name_ar": "الأنعام",
        "text": "لا شريك له وبذلك أمرت وأنا أول المسلمين"
      },
      {
        "ref": "2:196",
        "reports": 26,
        "sura_name_ar": "البقرة",
        "text": "وأتموا الحج والعمرة لله فإن أحصرتم فما استيسر من الهدي ولا تحلقوا رءوسكم حتى يبلغ الهدي مح"
      },
      {
        "ref": "5:3",
        "reports": 26,
        "sura_name_ar": "المائدة",
        "text": "حرمت عليكم الميتة والدم ولحم الخنزير وما أهل لغير الله به والمنخنقة والموقوذة والمتردية وا"
      },
      {
        "ref": "33:21",
        "reports": 26,
        "sura_name_ar": "الأحزاب",
        "text": "لقد كان لكم في رسول الله أسوة حسنة لمن كان يرجو الله واليوم الآخر وذكر الله كثيرا"
      },
      {
        "ref": "2:125",
        "reports": 24,
        "sura_name_ar": "البقرة",
        "text": "وإذ جعلنا البيت مثابة للناس وأمنا واتخذوا من مقام إبراهيم مصلى وعهدنا إلى إبراهيم وإسماعيل"
      },
      {
        "ref": "33:33",
        "reports": 24,
        "sura_name_ar": "الأحزاب",
        "text": "وقرن في بيوتكن ولا تبرجن تبرج الجاهلية الأولى وأقمن الصلاة وآتين الزكاة وأطعن الله ورسوله "
      },
      {
        "ref": "2:203",
        "reports": 23,
        "sura_name_ar": "البقرة",
        "text": "واذكروا الله في أيام معدودات فمن تعجل في يومين فلا إثم عليه ومن تأخر فلا إثم عليه لمن اتقى"
      },
      {
        "ref": "3:97",
        "reports": 23,
        "sura_name_ar": "آل عمران",
        "text": "فيه آيات بينات مقام إبراهيم ومن دخله كان آمنا ولله على الناس حج البيت من استطاع إليه سبيلا"
      },
      {
        "ref": "8:41",
        "reports": 21,
        "sura_name_ar": "الأنفال",
        "text": "واعلموا أنما غنمتم من شيء فأن لله خمسه وللرسول ولذي القربى واليتامى والمساكين وابن السبيل "
      },
      {
