{"id": "t10-d8da79", "status": "read", "groups": [{"levels": [[{"surface": "أبو داود، سليمان بن سيف", "kind": "narrator"}], [{"surface": "الحسن", "kind": "narrator"}], [{"surface": "زهير", "kind": "narrator", "occurrence": 1}]]}, {"levels": [[{"surface": "محمد بن إسماعيل بن إبراهيم", "kind": "narrator"}], [{"surface": "يحيى", "kind": "narrator"}], [{"surface": "زهير بن معاوية", "kind": "narrator"}]]}], "shared_tail": [[{"surface": "أبو إسحاق", "kind": "narrator"}], [{"surface": "الأسود", "kind": "narrator"}, {"surface": "مسروق", "kind": "narrator"}, {"surface": "عبيدة", "kind": "narrator"}], [{"surface": "عبد الله", "kind": "narrator"}]], "needs_ruling": false, "notes": ["The gloss «وهو ابن أعين» is left out. The two branches («ح») meet at Zuhair; the names after the last «ح» are written once and belong to both (rule 3). The Companion Abd Allah is the last link."], "fixes": []}