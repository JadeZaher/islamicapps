{"id":"t02-86b5b4","status":"read","groups":[{"levels":[[{"surface":"أبو بكر بن أبي شيبة","kind":"narrator"}],[{"surface":"عبد الله بن نمير","kind":"narrator"},{"surface":"أبو أسامة","kind":"narrator"}],[{"surface":"عبيد الله","kind":"narrator"}]]},{"levels":[[{"surface":"ابن نمير","kind":"narrator"}],[{"surface":"أبي","kind":"relation"}],[{"surface":"عبيد الله","kind":"narrator"}]]},{"levels":[[{"surface":"قتيبة","kind":"narrator"},{"surface":"محمد بن رمح","kind":"narrator"}],[{"surface":"الليث بن سعد","kind":"narrator"}]]},{"levels":[[{"surface":"زهير بن حرب","kind":"narrator"}],[{"surface":"إسماعيل","kind":"narrator"}],[{"surface":"أيوب","kind":"narrator"}]]},{"levels":[[{"surface":"ابن رافع","kind":"narrator"}],[{"surface":"ابن أبي فديك","kind":"narrator"}],[{"surface":"الضحاك","kind":"narrator"}]]},{"levels":[[{"surface":"هارون بن عبد الله","kind":"narrator"}],[{"surface":"حجاج بن محمد","kind":"narrator"}],[{"surface":"ابن جريج","kind":"narrator"}],[{"surface":"موسى بن عقبة","kind":"narrator"}]]},{"levels":[[{"surface":"مالك","kind":"narrator"}]],"variant":true}],"shared_tail":[[{"surface":"نافع","kind":"narrator"}],[{"surface":"ابن عمر","kind":"narrator"}]],"needs_ruling":false,"notes":["Six «ح» branches meet at «كلهم عن نافع، عن ابن عمر»; that shared tail is written once and belongs to every branch.","«حدثنا أبي جميعا، عن عبيد الله» : «أبي» is a relation (father of ابن نمير, rule 7); «جميعا» makes عبيد الله the next name for the co-transmitters of the first branch too.","«- يعني ابن علية -», «- يعني ابن عثمان -» are editor's glosses; «إلا الضحاك فإن في حديثه نخامة» is a wording remark, left out.","«بمعنى حديث مالك» names Malik for the same saying: a variant group (rule 4), not a route."],"fixes":[]}