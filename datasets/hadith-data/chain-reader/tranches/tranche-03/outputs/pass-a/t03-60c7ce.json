{"id":"t03-60c7ce","status":"read","groups":[{"levels":[[{"surface":"بشر بن الحكم","kind":"narrator"},{"surface":"إبراهيم بن دينار","kind":"narrator"},{"surface":"عبد الجبار بن العلاء","kind":"narrator"}],[{"surface":"سفيان بن عيينة","kind":"narrator"}],[{"surface":"حميد الأعرج","kind":"narrator"}],[{"surface":"سليمان بن عتيق","kind":"narrator"}],[{"surface":"جابر","kind":"narrator"}]]},{"levels":[[{"surface":"أبو إسحاق","kind":"narrator"}],[{"surface":"عبد الرحمن بن بشر","kind":"narrator"}],[{"surface":"سفيان","kind":"narrator","occurrence":2}],[{"surface":"بهذا","kind":"back_reference"}]]}],"shared_tail":null,"needs_ruling":false,"notes":["«- واللفظ لبشر -» and «- وهو صاحب مسلم -» are glosses, left out. The second isnad («قال أبو إسحاق ... حدثنا عبد الرحمن بن بشر عن سفيان بهذا») repeats the saying, so it is a second group; «بهذا» stands for the rest of the first chain."],"fixes":[]}